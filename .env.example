# DAH Arena 로컬 설정 — cp .env.example .env 후 필요한 값만 수정

# ── 참가자 페이지 ──────────────────────────────────────────────
DASHBOARD_PORT=4100

# ── 라운드 진행(로컬은 짧게, 리허설 실측은 1200/1200) ──────────
ROUND_SECONDS=180
BREAK_SECONDS=120
PULL_LEAD_SECONDS=60
AUTOSTART=1

# 테스트베드: 16라운드 완주 후 멈추지 않고 처음부터 계속 반복
LOOP=1
# 운영 제어 API(즉시 reload·skip) 허용
ALLOW_CONTROL=1

# ── 레지스트리 모드 ───────────────────────────────────────────
# local  = 로컬 registry 컨테이너(혼자·단일 PC, 기본)
# remote = 원격 레지스트리로 팀 협업(다른 PC의 팀원과 이미지 공유)
# REGISTRY_MODE=remote
# REMOTE_REGISTRY=ghcr.io/dah-aexploit
# 원격 모드 전에: docker login ghcr.io (org 패키지 read/write 권한 PAT)

# ── 실행 노드 아키텍처 ────────────────────────────────────────
# 기본은 호스트 아키텍처(Makefile 이 자동 설정). 여기서 강제 지정할 수 있다.
# linux/amd64 로 두고 arm64 이미지를 push 하면 리허설의 미반영 사고가 재현된다.
# NODE_PLATFORM=linux/arm64

# ── 토큰 salt(팀 토큰 파생 시드) ──────────────────────────────
ARENA_SALT=dah-arena-local

# ── LLM budget(USD) ───────────────────────────────────────────
LLM_BUDGET=20

# ── LLM upstream(선택) ────────────────────────────────────────
# 비워 두면 litellm-gw 가 목(mock) 응답으로 동작해 키 없이 인프라 검증이 된다.
# 실제 모델을 쓰려면 Azure Foundry endpoint(+ /openai/v1)와 키를 채운다.
AZURE_API_BASE=
AZURE_API_KEY=
# 또는 OpenAI 호환 upstream
LLM_UPSTREAM_BASE=
LLM_UPSTREAM_KEY=
